# Dependencies and package-manager caches
node_modules/
.npm/

# Local configuration, credentials, and signing material
.env
.env.*
!.env.example
*.local
*.key
*.pem
*.pfx
*.p12

# Python environments, caches, and bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated TypeScript output. Selected release builds are re-included below.
dist/
desktop/generated/
*.tsbuildinfo

# Publish the compiled server, but never its machine-specific runtime.json.
!desktop/generated/
desktop/generated/*
!desktop/generated/server.mjs

# Publish the production web build.
!packages/web/dist/
!packages/web/dist/**

# Publish only the distributable Windows release files. win-unpacked contains a
# 225+ MB executable that exceeds GitHub's normal per-file limit and is
# reproducible with `npm run desktop:dir`.
desktop-dist/*
!desktop-dist/latest.yml
!desktop-dist/MotionScore Setup 0.1.0.exe.blockmap
!desktop-dist/SHA256SUMS.txt

# Stray TypeScript emits beside source files
packages/web/src/**/*.js
packages/web/src/**/*.d.ts
!packages/web/src/client/src/css.d.ts

# Test and coverage output
coverage/

# Runtime, uploads, generated stems, and scratch files
tmp/
.tmp*/
*.log
npm-debug.log*
.stems-seg-test.json
music/

# IDE, agent, and OS configuration
.vscode/
.idea/
.kiro/
docs/
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini
