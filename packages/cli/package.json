{
  "name": "@motionscore/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI entry point that orchestrates the MotionScore pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "motionscore": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@motionscore/types": "0.1.0",
    "@motionscore/note-extractor": "0.1.0",
    "@motionscore/musical-mapper": "0.1.0",
    "@motionscore/trajectory-solver": "0.1.0",
    "@motionscore/renderer": "0.1.0",
    "@motionscore/video-export": "0.1.0",
    "commander": "15.0.0",
    "fluent-ffmpeg": "2.1.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/fluent-ffmpeg": "2.1.28",
    "@tonejs/midi": "2.0.28"
  }
}
