{
  "name": "@motionscore/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "concurrently \"npx tsx watch src/server.ts\" \"npx vite --config src/client/vite.config.ts\"",
    "build:client": "npx vite build --config src/client/vite.config.ts --outDir ../../dist/client",
    "build:server": "npx tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@motionscore/cli": "0.1.0",
    "@motionscore/types": "0.1.0",
    "express": "4.21.2",
    "multer": "1.4.5-lts.2",
    "cors": "2.8.5",
    "nanoid": "5.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/multer": "1.4.12",
    "@types/cors": "2.8.17",
    "@types/node": "22.15.21",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "6.3.5",
    "@vitejs/plugin-react": "4.5.2",
    "typescript": "5.8.3",
    "tsx": "4.19.4",
    "concurrently": "9.1.2"
  }
}
