{
  "name": "motionscore",
  "version": "0.1.0",
  "private": true,
  "description": "Neural-stem music visualizer: audio -> live 2D physics scene (web)",
  "type": "module",
  "workspaces": [
    "packages/types",
    "packages/note-extractor",
    "packages/web"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "web:dev": "npm run dev -w @motionscore/web",
    "web:build": "npm run build -w @motionscore/web",
    "web:start": "npm run start -w @motionscore/web"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "fast-check": "4.9.0"
  }
}
